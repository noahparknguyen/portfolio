{
  "name": "portfolio",
  "compatibility_date": "2026-07-13",
  "main": "worker/index.js",
  // Serve only from the custom domains below. Disables the default
  // *.noahparknguyen.workers.dev subdomain and preview URLs (clears the
  // workers.dev TLS/HTTPS/HSTS security warnings). Takes effect on next deploy.
  "workers_dev": false,
  "preview_urls": false,
  // Worker logs/metrics in the dashboard (Workers & Pages -> this Worker ->
  // Observability). Handy for debugging the /api/* widget routes.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Run the Worker before static-asset serving so the fetch() handler runs on
    // EVERY request (including the root and other real assets). Required for the
    // www->apex redirect to fire on `/` — by default assets are served first and
    // the Worker is skipped for asset-matching paths. The Worker's default route
    // still delegates to env.ASSETS.fetch(), so assets serve as before, now also
    // carrying the Worker's security headers (unifying the header source).
    "run_worker_first": true,
  },
  "routes": [
    { "pattern": "noahpn.dev", "custom_domain": true },
    { "pattern": "www.noahpn.dev", "custom_domain": true },
  ],
}
