{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-07-13",
  "main": "worker/index.js",
  // Serve only from the custom domains below. Disables the default
  // *.noahparknguyen.workers.dev subdomain and preview URLs (clears the
  // workers.dev TLS/HTTPS/HSTS security warnings).
  "workers_dev": false,
  "preview_urls": false,
  // Worker logs/metrics in the dashboard (Workers & Pages -> this Worker ->
  // Observability). Handy for debugging the /api/* widget routes.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // "none", not the single-page-application fallback, which would answer a
    // missing file with index.html and a 200. The Worker serves the app's
    // shell for its own pages, and a 404 for everything else that's missing.
    "not_found_handling": "none",
    // Run the Worker before static-asset serving, so the fetch() handler runs on
    // every request, including the root and other real assets. The www->apex
    // redirect needs it to fire on `/`: by default assets are served first and
    // the Worker is skipped for asset-matching paths. The Worker's default route
    // delegates to env.ASSETS.fetch(), so assets still serve, carrying the
    // Worker's security headers.
    "run_worker_first": true,
  },
  "routes": [
    { "pattern": "noahpn.dev", "custom_domain": true },
    { "pattern": "www.noahpn.dev", "custom_domain": true },
  ],
}
