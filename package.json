    "format:check": "prettier --check .",
    "check:config": "node scripts/check-config.mjs",
    "audit:styles": "node scripts/audit-styles.mjs",
    "audit:browser": "node scripts/audit-browser.mjs",
    "shoot:docs": "node scripts/shoot-docs.mjs",
    "check": "npm run lint && npm run format:check && npm run check:config && npm run audit:styles && npm run test:run && npm run build && npm run audit:browser"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "react": "^19.2.7",
