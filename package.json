{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:config": "node scripts/check-config.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "audit:styles": "node scripts/audit-styles.mjs",
    "audit:browser": "node scripts/audit-browser.mjs",
    "shoot:docs": "node scripts/shoot-docs.mjs",
    "vendor:fonts": "node scripts/vendor-fonts.mjs",
    "check": "npm run lint && npm run format:check && npm run check:config && npm run check:icons && npm run audit:styles && npm run test:run && npm run build && npm run audit:browser"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "simple-icons": "^16.35.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.111.0"
  }
}
